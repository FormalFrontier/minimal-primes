module

public import MinimalPrimes.RingTheory.Ideal.FiniteHeightChain
public import Mathlib.Algebra.Polynomial.RingDivision
public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
public import Mathlib.RingTheory.Polynomial.Basic

/-!
# Boundaries for descending prime chains

For a field `k`, a chain in `k[t]` can wait at `(t)` for any finite number of steps before dropping
to zero. The primeness and initial height-one hypotheses use Mathlib's polynomial and height
APIs, independently of the chain statements. Both the ideal and prime-spectrum interfaces are used.
The Noetherian client uses the existing finite-height instance, without assuming a globally
finite Krull dimension, a domain, or an Artinian ring.

The zero prime in `k[X₀, X₁, ...]` has height zero. This verifies a finite-initial-height boundary
in an infinite-variable polynomial ring without a Noetherian hypothesis. The zero-ring example
checks that a sequence of proper primes cannot exist. The zero prime in the semiring `ℕ`
also exercises the spectrum interface without a commutative-ring structure.

## Mathematical sketch: an infinite-variable genuine drop

The following argument is not formalized in this module. In `k[X₀, X₁, ...]`, the ideal `(X₀)` is
prime, since its quotient is a polynomial ring in the remaining variables and hence a domain.
For a nonzero prime `Q ⊆ (X₀)`, choose a nonzero `f ∈ Q` and write `f = X₀ʳ g`, where `r ≥ 1`
and `g ∉ (X₀)`. Since `g ∉ Q`, primeness gives `X₀ ∈ Q`, so `Q = (X₀)`. Thus `(X₀)` has height
one, and the chain `(X₀), 0, 0, ...` has a genuine drop and intersection zero.

This ring is not Noetherian: the ideal generated by all the variables is not finitely generated.
Any proposed finite list of generators involves only finitely many variables. Setting those
variables to zero annihilates the generators but not a variable outside that list. The same
finite-variable prime chains also make the ring's Krull dimension unbounded.

## Mathematical sketch: primeness is needed at every index

In `k[t]`, set `J n = (tⁿ⁺¹)`. These ideals form a strictly descending, nonstationary sequence:
`tⁿ⁺¹` does not belong to `(tⁿ⁺²)`. The initial ideal `(t)` is prime of height one, but the later
ideals are not prime: for `n ≥ 1`, `t · tⁿ ∈ J n` while neither factor belongs to `J n`.
This is a counterexample to keeping only initial primeness, even over a Noetherian domain of
Krull dimension one. It also explains why finite `Ideal.height` does not assert well-foundedness
of the lower interval in the lattice of all ideals. This argument is not formalized here.
-/

@[expose] public section

universe u

namespace PrimeHeightChainExamples

private noncomputable def polynomialDrop (k : Type u) [Field k] (d n : ℕ) : Ideal (Polynomial k) :=
  if n ≤ d then Ideal.span {Polynomial.X} else ⊥

private theorem polynomial_X_prime {k : Type u} [Field k] :
    (Ideal.span {Polynomial.X} : Ideal (Polynomial k)).IsPrime :=
  Ideal.isPrime_span_singleton_of_prime Polynomial.prime_X

private theorem polynomial_X_height {k : Type u} [Field k] :
    (Ideal.span {Polynomial.X} : Ideal (Polynomial k)).height = 1 :=
  Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero) Polynomial.prime_X.not_isUnit

private theorem polynomialDrop_prime (k : Type u) [Field k] (d n : ℕ) :
    (polynomialDrop k d n).IsPrime := by
  unfold polynomialDrop
  split_ifs
  · exact polynomial_X_prime
  · infer_instance

private theorem polynomialDrop_antitone (k : Type u) [Field k] (d : ℕ) :
    Antitone (polynomialDrop k d) := by
  intro i j hij
  unfold polynomialDrop
  split_ifs <;> first | exact le_rfl | exact bot_le | omega

private theorem polynomialDrop_initial_height (k : Type u) [Field k] (d : ℕ) :
    (polynomialDrop k d 0).height = 1 := by
  simpa [polynomialDrop] using (polynomial_X_height (k := k))

-- The initial-height hypothesis is obtained from an existing instance, not from stabilization.
private theorem polynomialDrop_initial_finiteHeight (k : Type u) [Field k] (d : ℕ) :
    (polynomialDrop k d 0).FiniteHeight :=
  inferInstance

-- A genuine drop, including when the plateau lasts for many steps.
private theorem polynomialDrop_ne_initial (k : Type u) [Field k] (d : ℕ) :
    polynomialDrop k d (d + 1) ≠ polynomialDrop k d 0 := by
  have h : ¬ d + 1 ≤ d := by omega
  simp only [polynomialDrop, ite_eq_right h, ite_eq_left (Nat.zero_le d)]
  intro heq
  exact Polynomial.X_ne_zero (Ideal.span_singleton_eq_bot.mp heq.symm)

-- The ideal interface supplies constancy and the intersection at a common index.
private theorem polynomialDrop_exists_stable (k : Type u) [Field k] (d : ℕ) :
    ∃ N : ℕ, (∀ n : ℕ, N ≤ n → polynomialDrop k d n = polynomialDrop k d N) ∧
      (⨅ n, polynomialDrop k d n) = polynomialDrop k d N :=
  Ideal.exists_stable_of_antitone_of_finiteHeight _
    (polynomialDrop_antitone k d) (polynomialDrop_prime k d)

private noncomputable def spectrumDrop (k : Type u) [Field k] (d n : ℕ) :
    PrimeSpectrum (Polynomial k) :=
  ⟨polynomialDrop k d n, polynomialDrop_prime k d n⟩

-- The spectrum interface uses its ideal-inclusion order and ambient order height.
private theorem spectrumDrop_exists_stable (k : Type u) [Field k] (d : ℕ) :
    ∃ N : ℕ, (∀ n : ℕ, N ≤ n → spectrumDrop k d n = spectrumDrop k d N) ∧
      (⨅ n, (spectrumDrop k d n).asIdeal) = (spectrumDrop k d N).asIdeal := by
  apply PrimeSpectrum.exists_stable_of_antitone_of_height_lt_top
  · intro i j hij
    exact (PrimeSpectrum.asIdeal_le_asIdeal _ _).mp (polynomialDrop_antitone k d hij)
  · rw [← PrimeSpectrum.height_eq_orderHeight]
    change (polynomialDrop k d 0).height < ⊤
    rw [polynomialDrop_initial_height]
    exact ENat.natCast_lt_top 1

-- The spectrum statement also applies to a semiring which is not a ring.
private theorem nat_spectrum_exists_stable : ∃ N : ℕ,
    (∀ n : ℕ, N ≤ n → (⊥ : PrimeSpectrum ℕ) = ⊥) ∧
      (⨅ _ : ℕ, (⊥ : PrimeSpectrum ℕ).asIdeal) = (⊥ : PrimeSpectrum ℕ).asIdeal := by
  apply PrimeSpectrum.exists_stable_of_antitone_of_height_lt_top (fun _ : ℕ => ⊥)
  · exact fun _ _ _ => le_rfl
  · rw [Order.height_bot]
    exact ENat.natCast_lt_top 0

-- The existing Noetherian finite-height instance discharges the initial-height argument.
private theorem noetherian_exists_stable {R : Type u} [CommRing R] [IsNoetherianRing R]
    (J : ℕ → Ideal R) (hJ : Antitone J) (hprime : ∀ n, (J n).IsPrime) :
    ∃ N : ℕ, (∀ n : ℕ, N ≤ n → J n = J N) ∧ (⨅ n, J n) = J N :=
  Ideal.exists_stable_of_antitone_of_finiteHeight J hJ hprime

-- The infinite-variable bottom prime has finite height independently of the new theorem.
private theorem infinitePolynomial_bot_isPrime (k : Type u) [Field k] :
    (⊥ : Ideal (MvPolynomial ℕ k)).IsPrime := inferInstance

private theorem infinitePolynomial_bot_height (k : Type u) [Field k] :
    (⊥ : Ideal (MvPolynomial ℕ k)).height = 0 :=
  Ideal.height_bot

private theorem infinitePolynomial_bot_finiteHeight (k : Type u) [Field k] :
    (⊥ : Ideal (MvPolynomial ℕ k)).FiniteHeight := by
  apply Ideal.finiteHeight_iff_lt.mpr
  right
  rw [Ideal.height_bot]
  exact ENat.natCast_lt_top 0

/-- A subsingleton commutative ring admits no sequence of prime ideals, since its prime spectrum
is empty. -/
theorem zero_ring_no_prime_sequence {R : Type u} [CommRing R] [Subsingleton R] :
    ¬ ∃ J : ℕ → Ideal R, ∀ n, (J n).IsPrime := by
  rintro ⟨J, hprime⟩
  exact isEmptyElim (⟨J 0, hprime 0⟩ : PrimeSpectrum R)

end PrimeHeightChainExamples
