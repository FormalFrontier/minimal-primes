module

public import MinimalPrimes.Order.Filter.Germ.Center
public import MinimalPrimes.Order.Filter.Product.Center
import Mathlib.Data.Fintype.Fin
import Mathlib.Tactic.FinCases

/-!
# A varying central germ over a nonassociative multiplication

The four-element multiplication has absorbing zero and identity one, but is neither
commutative nor associative. At the principal filter generated by the first two
indices, the values `0, 1, 2` represent a central germ which is neither pointwise
central nor constant: the noncentral third value is ignored by the filter.
The center equivalence lifts this germ to a total center-valued function,
retaining the first two values while necessarily changing at least one ignored value.
-/

@[expose] public section

open Filter

namespace MinimalPrimesTest.GermCenter

/-- The multiplication table for the four-element nonassociative client. -/
def fourElementMul (a b : Fin 4) : Fin 4 :=
  match a.val, b.val with
  | 0, _ | _, 0 => 0
  | 1, _ => b
  | _, 1 => a
  | 2, 2 => 3
  | 2, 3 => 2
  | 3, 2 => 3
  | _, _ => 2

/-- The client's local multiplication is the four-element table. -/
local instance instMulFinFour : Mul (Fin 4) := ⟨fourElementMul⟩

/-- One is a two-sided identity for the client's multiplication table. -/
local instance instMulOneClassFinFour : MulOneClass (Fin 4) where
  one := 1
  mul := fourElementMul
  one_mul a := by fin_cases a <;> rfl
  mul_one a := by fin_cases a <;> rfl

/-- The three coordinate values `0, 1, 2` in the four-element client. -/
def varyingValue (i : Fin 3) : Fin 4 :=
  ⟨i.val, Nat.lt_trans i.isLt (by decide)⟩

/-- The retained central fibres give a nonconstant central germ, despite the ignored
noncentral fibre and the noncommutative, nonassociative multiplication. -/
theorem varyingValue_central_germ :
    (varyingValue : Germ (Filter.principal ({0, 1} : Set (Fin 3))) (Fin 4)) ∈
        Submonoid.center (Germ (Filter.principal ({0, 1} : Set (Fin 3))) (Fin 4)) ∧
      ¬ (∀ i, varyingValue i ∈ Set.center (Fin 4)) ∧
      ¬ (varyingValue : Germ (Filter.principal ({0, 1} : Set (Fin 3))) (Fin 4)).IsConstant ∧
      (2 * 3 : Fin 4) ≠ 3 * 2 ∧ ((2 * 2) * 2 : Fin 4) ≠ 2 * (2 * 2) := by
  have hz : (0 : Fin 4) ∈ Set.center (Fin 4) := by
    refine ⟨?_, ?_, ?_⟩
    · intro a
      apply (commute_iff_eq _ _).mpr
      fin_cases a <;> decide
    · intro a b
      fin_cases a <;> fin_cases b <;> decide
    · intro a b
      fin_cases a <;> fin_cases b <;> decide
  refine ⟨?_, ?_, ?_, by decide, by decide⟩
  · apply (Germ.mem_submonoid_center_coe_iff _ _).mpr
    rw [Filter.eventually_principal]
    intro i hi
    have hi' : i = 0 ∨ i = 1 := by
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hi
    rcases hi' with rfl | rfl
    · exact hz
    · exact Set.one_mem_center
  · intro h
    have hbad := (h 2).comm 3
    change (2 : Fin 4) = 3 at hbad
    exact (by decide : (2 : Fin 4) ≠ 3) hbad
  · intro h
    change ∃ c : Fin 4, ∀ᶠ i in Filter.principal ({0, 1} : Set (Fin 3)),
      varyingValue i = c at h
    obtain ⟨c, hc⟩ := h
    rw [Filter.eventually_principal] at hc
    have h0 : (0 : Fin 4) = c := hc 0 (by simp)
    have h1 : (1 : Fin 4) = c := hc 1 (by simp)
    exact (by decide : (0 : Fin 4) ≠ 1) (h0.trans h1.symm)

/-- A global center-valued lift of the varying germ through the representative API. -/
noncomputable def liftedVaryingValue : Fin 3 → ↥(Submonoid.center (Fin 4)) :=
  Germ.centerRepresentative (Filter.principal ({0, 1} : Set (Fin 3)))
    ⟨(varyingValue : Germ (Filter.principal ({0, 1} : Set (Fin 3))) (Fin 4)),
      varyingValue_central_germ.1⟩

/-- The total central lift retains the two distinct observed values but cannot
agree pointwise with the original function, whose ignored value is noncentral. -/
theorem liftedVaryingValue_retained :
    (liftedVaryingValue 0 : Fin 4) = 0 ∧ (liftedVaryingValue 1 : Fin 4) = 1 ∧
      (fun i => (liftedVaryingValue i : Fin 4)) ≠ varyingValue := by
  have h := Germ.centerRepresentative_eventuallyEq
    (Filter.principal ({0, 1} : Set (Fin 3))) varyingValue varyingValue_central_germ.1
  change ∀ᶠ i in Filter.principal ({0, 1} : Set (Fin 3)),
    (liftedVaryingValue i : Fin 4) = varyingValue i at h
  rw [Filter.eventually_principal] at h
  refine ⟨h 0 (by simp), h 1 (by simp), ?_⟩
  intro heq
  apply varyingValue_central_germ.2.1
  intro i
  rw [← congrFun heq i]
  exact (liftedVaryingValue i).property

/-- A section of genuinely varying fibres, using the same four-element multiplication. -/
def varyingSection (i : Fin 3) : Fin (i.val + 1) → Fin 4 :=
  fun _ => varyingValue i

/-- The two retained fibres have different cardinalities. -/
theorem varyingSection_fibre_card :
    Fintype.card (Fin 1 → Fin 4) = 4 ∧ Fintype.card (Fin 2 → Fin 4) = 16 := by
  decide

/-- The dependent section is central in the product but not pointwise central.
The two retained fibres have different sizes and retain nonassociative multiplication. -/
theorem varyingSection_central_product :
    (varyingSection : (Filter.principal ({0, 1} : Set (Fin 3))).Product
        (fun i => Fin (i.val + 1) → Fin 4)) ∈
      Submonoid.center ((Filter.principal ({0, 1} : Set (Fin 3))).Product
        (fun i => Fin (i.val + 1) → Fin 4)) ∧
      ¬ (∀ i, varyingSection i ∈ Set.center (Fin (i.val + 1) → Fin 4)) ∧
      ¬ (∀ a b c : Fin 1 → Fin 4, (a * b) * c = a * (b * c)) := by
  have hc := (Germ.mem_submonoid_center_coe_iff _ _).1 varyingValue_central_germ.1
  rw [Filter.eventually_principal] at hc
  refine ⟨?_, ?_, ?_⟩
  · apply (Product.mem_submonoid_center_coe_iff _ varyingSection).2
    rw [Filter.eventually_principal]
    intro i hi
    change varyingSection i ∈ Set.center (Fin (i.val + 1) → Fin 4)
    rw [Set.center_pi]
    intro j _
    exact hc i hi
  · intro h
    have hb := congrFun ((h 2).comm (fun _ => (3 : Fin 4))).eq 0
    change (2 : Fin 4) = 3 at hb
    exact (by decide : (2 : Fin 4) ≠ 3) hb
  · intro h
    have hb := congrFun (h (fun _ => 2) (fun _ => 2) (fun _ => 2)) 0
    exact varyingValue_central_germ.2.2.2.2 hb

/-- The product does not collapse: the all-zero and all-one sections are distinct. -/
theorem varyingSection_product_nontrivial :
    ((fun i : Fin 3 => (0 : Fin (i.val + 1) → Fin 4)) :
        (Filter.principal ({0, 1} : Set (Fin 3))).Product
          (fun i => Fin (i.val + 1) → Fin 4)) ≠
      ((fun i : Fin 3 => (1 : Fin (i.val + 1) → Fin 4)) :
        (Filter.principal ({0, 1} : Set (Fin 3))).Product
          (fun i => Fin (i.val + 1) → Fin 4)) := by
  intro h
  have he := (Product.coe_eq _ _).1 h
  rw [Filter.eventually_principal] at he
  have hb := congrFun (he 0 (by simp)) 0
  exact (by decide : (0 : Fin 4) ≠ 1) hb

/-- A total fibre-center-valued lift of the genuinely dependent central section. -/
noncomputable def liftedVaryingSection (i : Fin 3) :
    ↥(Submonoid.center (Fin (i.val + 1) → Fin 4)) :=
  Product.centerRepresentative (Filter.principal ({0, 1} : Set (Fin 3)))
    ⟨(varyingSection : (Filter.principal ({0, 1} : Set (Fin 3))).Product
      (fun i => Fin (i.val + 1) → Fin 4)), varyingSection_central_product.1⟩ i

/-- The dependent center-valued lift preserves both observed fibres, but cannot
preserve the ignored noncentral value everywhere. No particular ignored value is asserted. -/
theorem liftedVaryingSection_retained :
    (liftedVaryingSection 0).val = (fun _ => 0) ∧
      (liftedVaryingSection 1).val = (fun _ => 1) ∧
      (fun i => (liftedVaryingSection i : Fin (i.val + 1) → Fin 4)) ≠ varyingSection := by
  have h := Product.centerRepresentative_eventuallyEq
    (Filter.principal ({0, 1} : Set (Fin 3))) varyingSection varyingSection_central_product.1
  change ∀ᶠ i in Filter.principal ({0, 1} : Set (Fin 3)),
    (liftedVaryingSection i : Fin (i.val + 1) → Fin 4) = varyingSection i at h
  rw [Filter.eventually_principal] at h
  refine ⟨h 0 (by simp), h 1 (by simp), ?_⟩
  intro heq
  apply varyingSection_central_product.2.1
  intro i
  rw [← congrFun heq i]
  exact (liftedVaryingSection i).property

end MinimalPrimesTest.GermCenter
