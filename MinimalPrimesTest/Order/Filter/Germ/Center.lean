module

public import MinimalPrimes.Order.Filter.Germ.Center
import Mathlib.Data.Fintype.Fin
import Mathlib.Tactic.FinCases

/-!
# A varying central germ over a nonassociative multiplication

The four-element multiplication has absorbing zero and identity one, but is neither
commutative nor associative. At the principal filter generated by the first two
indices, the values `0, 1, 2` represent a central germ which is neither pointwise
central nor constant: the noncentral third value is ignored by the filter.
-/

@[expose] public section

open Filter

namespace MinimalPrimesTest.GermCenter

/-- The multiplication table for the four-element nonassociative client. -/
def fourElementMul (a b : Fin 4) : Fin 4 :=
  match a.val, b.val with
  | 0, _ | _, 0 => 0
  | 1, _ => b
  | _, 1 => a
  | 2, 2 => 3
  | 2, 3 => 2
  | 3, 2 => 3
  | _, _ => 2

/-- The client's local multiplication is the four-element table. -/
local instance instMulFinFour : Mul (Fin 4) := ⟨fourElementMul⟩

/-- One is a two-sided identity for the client's multiplication table. -/
local instance instMulOneClassFinFour : MulOneClass (Fin 4) where
  one := 1
  mul := fourElementMul
  one_mul a := by fin_cases a <;> rfl
  mul_one a := by fin_cases a <;> rfl

/-- The three coordinate values `0, 1, 2` in the four-element client. -/
def varyingValue (i : Fin 3) : Fin 4 :=
  ⟨i.val, Nat.lt_trans i.isLt (by decide)⟩

/-- The retained central fibres give a nonconstant central germ, despite the ignored
noncentral fibre and the noncommutative, nonassociative multiplication. -/
theorem varyingValue_central_germ :
    (varyingValue : Germ (Filter.principal ({0, 1} : Set (Fin 3))) (Fin 4)) ∈
        Submonoid.center (Germ (Filter.principal ({0, 1} : Set (Fin 3))) (Fin 4)) ∧
      ¬ (∀ i, varyingValue i ∈ Set.center (Fin 4)) ∧
      ¬ (varyingValue : Germ (Filter.principal ({0, 1} : Set (Fin 3))) (Fin 4)).IsConstant ∧
      (2 * 3 : Fin 4) ≠ 3 * 2 ∧ ((2 * 2) * 2 : Fin 4) ≠ 2 * (2 * 2) := by
  have hz : (0 : Fin 4) ∈ Set.center (Fin 4) := by
    refine ⟨?_, ?_, ?_⟩
    · intro a
      apply (commute_iff_eq _ _).mpr
      fin_cases a <;> decide
    · intro a b
      fin_cases a <;> fin_cases b <;> decide
    · intro a b
      fin_cases a <;> fin_cases b <;> decide
  refine ⟨?_, ?_, ?_, by decide, by decide⟩
  · apply (Germ.mem_submonoid_center_coe_iff _ _).mpr
    rw [Filter.eventually_principal]
    intro i hi
    have hi' : i = 0 ∨ i = 1 := by
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hi
    rcases hi' with rfl | rfl
    · exact hz
    · exact Set.one_mem_center
  · intro h
    have hbad := (h 2).comm 3
    change (2 : Fin 4) = 3 at hbad
    exact (by decide : (2 : Fin 4) ≠ 3) hbad
  · intro h
    change ∃ c : Fin 4, ∀ᶠ i in Filter.principal ({0, 1} : Set (Fin 3)),
      varyingValue i = c at h
    obtain ⟨c, hc⟩ := h
    rw [Filter.eventually_principal] at hc
    have h0 : (0 : Fin 4) = c := hc 0 (by simp)
    have h1 : (1 : Fin 4) = c := hc 1 (by simp)
    exact (by decide : (0 : Fin 4) ≠ 1) (h0.trans h1.symm)

end MinimalPrimesTest.GermCenter
