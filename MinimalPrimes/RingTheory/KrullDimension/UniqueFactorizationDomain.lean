module

public import Mathlib.RingTheory.KrullDimension.Basic
public import Mathlib.RingTheory.UniqueFactorizationDomain.Ideal

/-!
# Prime ideals in unique factorization semirings of dimension at most two

In a commutative semiring with unique factorization and Krull dimension at most two,
every nonzero nonmaximal prime ideal is generated by an irreducible element. Thus every
prime ideal is zero, generated by an irreducible element, or maximal. These alternatives
may overlap: in a field the zero ideal is maximal, and in a one-dimensional principal
ideal domain a nonzero prime ideal is both irreducible-principal and maximal.

The statements do not require Noetherianity, a normalization choice, or global
nontriviality. The trivial semiring has no prime ideals, so the classification is
vacuous there. This is a forward classification, not a converse characterizing
unique factorization or the dimension bound.

## References

The prime-element extraction and finite-chain dimension interfaces are the earlier
Mathlib formalizations `Ideal.IsPrime.exists_mem_prime_of_ne_bot` and
`Order.LTSeries.length_le_krullDim`. They use Mathlib's existing ideals, prime spectrum,
and strict relation series.
-/

@[expose] public section

universe u

namespace Ideal.IsPrime

variable {R : Type u} [CommSemiring R] [UniqueFactorizationMonoid R]
    [Ring.KrullDimLE 2 R] {I : Ideal R}

/-- A nonzero nonmaximal prime ideal in a commutative unique factorization semiring
of Krull dimension at most two is generated by an irreducible element. -/
theorem exists_irreducible_span_eq_of_ne_bot_of_not_isMaximal
    (hI : I.IsPrime) (hI0 : I ≠ ⊥) (hImax : ¬ I.IsMaximal) :
    ∃ a : R, Irreducible a ∧ I = Ideal.span ({a} : Set R) := by
  classical
  obtain ⟨a, ha, hpa⟩ := hI.exists_mem_prime_of_ne_bot hI0
  let : Nontrivial R := nontrivial_of_ne a 0 hpa.ne_zero
  refine ⟨a, hpa.irreducible, ?_⟩
  have hJ : Ideal.span ({a} : Set R) ≤ I :=
    (Ideal.span_singleton_le_iff_mem I).mpr ha
  have hJ0 : Ideal.span ({a} : Set R) ≠ ⊥ :=
    fun h => hpa.ne_zero (Ideal.span_singleton_eq_bot.mp h)
  obtain ⟨M, hM, hIM⟩ := Ideal.exists_le_maximal I hI.ne_top
  have hIM' : I < M := lt_of_le_of_ne hIM (by
    rintro rfl
    exact hImax hM)
  by_contra hEq
  have hJI : Ideal.span ({a} : Set R) < I := lt_of_le_of_ne hJ (Ne.symm hEq)
  -- Unequal ideals would give three strict inclusions of prime ideals.
  let p0 : PrimeSpectrum R := ⟨⊥, Ideal.isPrime_bot⟩
  let p1 : PrimeSpectrum R := ⟨Ideal.span {a}, Ideal.isPrime_span_singleton_of_prime hpa⟩
  let p2 : PrimeSpectrum R := ⟨I, hI⟩
  let p3 : PrimeSpectrum R := ⟨M, hM.isPrime⟩
  have h01 : p0 < p1 :=
    (PrimeSpectrum.asIdeal_lt_asIdeal p0 p1).mp (bot_lt_iff_ne_bot.mpr hJ0)
  have h12 : p1 < p2 := (PrimeSpectrum.asIdeal_lt_asIdeal p1 p2).mp hJI
  have h23 : p2 < p3 := (PrimeSpectrum.asIdeal_lt_asIdeal p2 p3).mp hIM'
  let c0 : LTSeries (PrimeSpectrum R) := RelSeries.singleton _ p0
  let c1 := c0.snoc p1 (by simpa [c0] using h01)
  let c2 := c1.snoc p2 (by simpa [c1] using h12)
  let c3 := c2.snoc p3 (by simpa [c2] using h23)
  have hdim : (3 : WithBot ℕ∞) ≤ ringKrullDim R := by
    simpa [ringKrullDim, c3, c2, c1, c0] using Order.LTSeries.length_le_krullDim c3
  have hbound : ringKrullDim R ≤ 2 :=
    (Ring.krullDimLE_iff (R := R) (n := 2)).mp inferInstance
  have hbad := hdim.trans hbound
  norm_num at hbad

/-- A prime ideal in a commutative unique factorization semiring of Krull dimension
at most two is zero, generated by an irreducible element, or maximal.
The alternatives need not be disjoint. -/
theorem eq_bot_or_exists_irreducible_span_eq_or_isMaximal (hI : I.IsPrime) :
    I = ⊥ ∨ (∃ a : R, Irreducible a ∧ I = Ideal.span ({a} : Set R)) ∨ I.IsMaximal := by
  by_cases hI0 : I = ⊥
  · exact Or.inl hI0
  right
  by_cases hImax : I.IsMaximal
  · exact Or.inr hImax
  exact Or.inl (hI.exists_irreducible_span_eq_of_ne_bot_of_not_isMaximal hI0 hImax)

end Ideal.IsPrime
