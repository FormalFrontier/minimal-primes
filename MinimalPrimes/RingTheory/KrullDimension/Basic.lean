module

public import Mathlib.Algebra.Prime.Defs
public import Mathlib.RingTheory.Ideal.MinimalPrime.Localization
public import Mathlib.RingTheory.KrullDimension.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Basic
public import MinimalPrimes.Order.KrullDimension

/-!
# Prime generators and dimension at most two

In a commutative semiring of Krull dimension at most two, a nonmaximal prime ideal
containing a prime element that is a non-zero-divisor is generated by that same element.
The regularity datum concerns only the chosen generator, not all nonzero elements.

Independently, a commutative semiring has Krull dimension at most two if each nonzero
nonmaximal prime ideal is generated by an irreducible element. This condition does not
require irreducible elements to be prime and imposes no condition on the zero or maximal
ideals.

## References

The relevant Mathlib interfaces are `Irreducible.dvd_symm` for monoids,
`Ideal.span_singleton_le_span_singleton` for commutative semirings, and the
order-theoretic dimension criterion `Order.krullDim_lt_coe_iff`.
Mathlib's `Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes` supplies minimal-prime
avoidance over commutative semirings; `PrimeSpectrum.isMin_iff` and
`PrimeSpectrum.isMax_iff` relate ideal properties to the spectrum order.
-/

@[expose] public section

universe u

/-- A nonmaximal prime ideal in dimension at most two is generated by any prime element
it contains that is a non-zero-divisor. -/
theorem Ideal.IsPrime.eq_span_singleton_of_prime_of_mem_nonZeroDivisors_of_not_isMaximal
    {R : Type u} [CommSemiring R] [Ring.KrullDimLE 2 R] {I : Ideal R} {a : R}
    (hI : I.IsPrime) (ha : Prime a) (hreg : a ∈ nonZeroDivisors R) (haMem : a ∈ I)
    (hImax : ¬ I.IsMaximal) : I = Ideal.span ({a} : Set R) := by
  let p : PrimeSpectrum R := ⟨Ideal.span {a}, Ideal.isPrime_span_singleton_of_prime ha⟩
  let q : PrimeSpectrum R := ⟨I, hI⟩
  have hp : ¬ _root_.IsMin p := by
    intro hpmin
    exact notMem_nonZeroDivisors_of_mem_mem_minimalPrimes
      (Ideal.mem_span_singleton_self a) (PrimeSpectrum.isMin_iff.mp hpmin) hreg
  have hq : ¬ _root_.IsMax q := fun hqmax => hImax (PrimeSpectrum.isMax_iff.mp hqmax)
  have hpq : p ≤ q := (Ideal.span_singleton_le_iff_mem I).mpr haMem
  exact le_antisymm
    (Order.KrullDimLE.le_of_le_of_not_isMin_of_not_isMax (α := PrimeSpectrum R) hpq hp hq) hpq

/-- A commutative semiring has Krull dimension at most two if every nonzero
nonmaximal prime ideal is generated by an irreducible element. -/
theorem Ring.krullDimLE_two_of_forall_exists_irreducible_span_eq
    {R : Type u} [CommSemiring R]
    (h : ∀ I : Ideal R, I.IsPrime → I ≠ ⊥ → ¬ I.IsMaximal →
      ∃ a : R, Irreducible a ∧ I = Ideal.span ({a} : Set R)) :
    Ring.KrullDimLE 2 R := by
  have no_four (p₀ p₁ p₂ p₃ : PrimeSpectrum R)
      (h₀₁ : p₀ < p₁) (h₁₂ : p₁ < p₂) (h₂₃ : p₂ < p₃) : False := by
    have h₀₁ := (PrimeSpectrum.asIdeal_lt_asIdeal p₀ p₁).mpr h₀₁
    have h₁₂ := (PrimeSpectrum.asIdeal_lt_asIdeal p₁ p₂).mpr h₁₂
    have h₂₃ := (PrimeSpectrum.asIdeal_lt_asIdeal p₂ p₃).mpr h₂₃
    have hp₁ : p₁.asIdeal ≠ ⊥ := (lt_of_le_of_lt bot_le h₀₁).ne'
    have hp₂ : p₂.asIdeal ≠ ⊥ := (lt_of_le_of_lt bot_le h₁₂).ne'
    have hm₁ : ¬ p₁.asIdeal.IsMaximal := fun hm =>
      h₁₂.ne (hm.eq_of_le p₂.isPrime.ne_top h₁₂.le)
    have hm₂ : ¬ p₂.asIdeal.IsMaximal := fun hm =>
      h₂₃.ne (hm.eq_of_le p₃.isPrime.ne_top h₂₃.le)
    obtain ⟨a, ha, hpa⟩ := h p₁.asIdeal p₁.isPrime hp₁ hm₁
    obtain ⟨b, hb, hpb⟩ := h p₂.asIdeal p₂.isPrime hp₂ hm₂
    have hba : b ∣ a := Ideal.span_singleton_le_span_singleton.mp (by
      rw [← hpa, ← hpb]
      exact h₁₂.le)
    apply h₁₂.not_ge
    rw [hpa, hpb]
    exact Ideal.span_singleton_le_span_singleton.mpr (hb.dvd_symm ha hba)
  have hlength (c : LTSeries (PrimeSpectrum R)) : c.length ≤ 2 := by
    by_contra hc
    have hc : 3 ≤ c.length := by omega
    exact no_four
      (c ⟨0, by omega⟩) (c ⟨1, by omega⟩) (c ⟨2, by omega⟩) (c ⟨3, by omega⟩)
      (c.strictMono (show (0 : ℕ) < 1 from Nat.zero_lt_succ 0))
      (c.strictMono (show (1 : ℕ) < 2 from Nat.lt_succ_self 1))
      (c.strictMono (show (2 : ℕ) < 3 from Nat.lt_succ_self 2))
  apply Ring.krullDimLE_iff.mpr
  rw [ringKrullDim]
  exact ENat.WithBot.lt_add_one_iff.mp
    ((Order.krullDim_lt_coe_iff (α := PrimeSpectrum R) (n := 3)).mpr
      (fun c => Nat.lt_succ_of_le (hlength c)))
